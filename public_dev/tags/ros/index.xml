    <item>
      <title>rust仿真环境配置: wsl &#43; ros2 &#43; rust</title>
      <link>https://hydarealman.github.io/wander/posts/1970/01/rust%E4%BB%BF%E7%9C%9F%E7%8E%AF%E5%A2%83%E9%85%8D%E7%BD%AE-wsl--ros2--rust/</link>
